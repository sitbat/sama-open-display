<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SamaRP_WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="28,20,28,28" Spacing="14">
        <Image Width="96" Height="96" HorizontalAlignment="Left" Source="/Assets/Square150x150Logo.scale-200.png" />
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="SamaRP" />
        <TextBlock FontSize="18" Text="SAMA Remastering Project" />
        <TextBlock MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap" Text="面向 SAMA 6.5 英寸 USB 小屏的开源重制项目。WinUI 3 前端使用 Windows App SDK 2.5.1，硬件写入继续由经过验证和身份校验的协议核心执行。" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WinUI 迁移预览版 · GPL-3.0-or-later" />
    </StackPanel>
</Page>
