<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SAMAOpenDisplay_WinUI.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SAMAOpenDisplay_WinUI.Models">

    <ScrollViewer>
        <Grid Padding="28,20,28,28" ColumnSpacing="20" RowSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.ColumnSpan="3" Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="显示与设备" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="安全预览不会访问硬件；发送前仍需确认设备身份。" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="14">
                <Border MinHeight="356" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="内容" />
                        <RadioButton x:Name="ThemeOption" GroupName="ContentMode" Content="使用主题" IsChecked="True" Checked="ThemeOption_Checked" />
                        <ComboBox
                            x:Name="ThemePicker"
                            Header="主题选择"
                            Height="64"
                            HorizontalAlignment="Stretch"
                            MaxDropDownHeight="280"
                            SelectionChanged="ThemePicker_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ThemeInfo">
                                    <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="ThemeDescription" Height="40" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <RadioButton x:Name="ImageOption" GroupName="ContentMode" Content="加载图片 / GIF" Checked="ImageOption_Checked" />
                        <TextBlock x:Name="ImageDescription" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <Button x:Name="ChooseImageButton" HorizontalAlignment="Stretch" Content="重新选择图片 / GIF" Click="ChooseImageButton_Click" Visibility="Collapsed" />
                        <RadioButton x:Name="TextOption" GroupName="ContentMode" Content="文字画面" Checked="TextOption_Checked" />
                        <TextBlock x:Name="TextDescription" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                        <Button x:Name="EditTextButton" HorizontalAlignment="Stretch" Content="编辑文字" Click="EditTextButton_Click" Visibility="Collapsed" />
                        <Button HorizontalAlignment="Stretch" Content="刷新预览" Click="RefreshPreview_Click" />
                    </StackPanel>
                </Border>
                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="显示参数" />
                        <TextBlock Text="亮度" />
                        <Slider x:Name="BrightnessSlider" Minimum="10" Maximum="100" Value="70" />
                        <ComboBox x:Name="FitPicker" Header="画面适配" SelectedIndex="0" SelectionChanged="FitPicker_SelectionChanged">
                            <ComboBoxItem Content="填满并裁切" />
                            <ComboBoxItem Content="完整包含" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" Grid.Column="1" Padding="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="1568 × 720 预览" />
                        <ProgressRing x:Name="PreviewProgress" HorizontalAlignment="Right" IsActive="False" Width="20" Height="20" />
                    </Grid>
                    <Border Grid.Row="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="2" Spacing="14">
                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="设备" />
                        <InfoBar x:Name="DeviceInfo" IsOpen="True" IsClosable="False" Severity="Informational" Title="正在检测小屏…" />
                        <Button HorizontalAlignment="Stretch" Content="重新检测" Click="Detect_Click" />
                    </StackPanel>
                </Border>
                <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="硬件操作" />
                        <Button x:Name="SendButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Content="发送当前画面" IsEnabled="False" Click="SendButton_Click" />
                        <Button x:Name="ContinuousButton" HorizontalAlignment="Stretch" Content="开始持续发送画面" IsEnabled="False" Click="ContinuousButton_Click" />
                        <InfoBar x:Name="HardwareInfo" IsOpen="False" IsClosable="True" />
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="单帧和持续发送都会先显示确认窗口，并再次核验设备协议身份。持续模式按 USB 链路可承受的低帧率运行。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
