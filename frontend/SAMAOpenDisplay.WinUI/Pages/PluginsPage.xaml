<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SAMAOpenDisplay_WinUI.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SAMAOpenDisplay_WinUI.Models">

    <Grid Padding="28,20,28,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="插件中心" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="批量管理自由布局主题、数据接口、前置依赖和执行权限。" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="批量安装…" Click="Install_Click" />
        </Grid>

        <InfoBar x:Name="StatusInfo" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <ListView x:Name="PluginList" Grid.Row="2" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:PluginInfo">
                    <Border Margin="0,0,0,8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="5">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock FontWeight="SemiBold" FontSize="16" Text="{x:Bind Name}" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Version}" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{x:Bind Description}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind DependencyLabel}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind PermissionLabel}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind TypeLabel}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind StateLabel}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="启用所选" Click="Enable_Click" />
                <Button Content="停用所选" Click="Disable_Click" />
                <Button Content="卸载所选" Click="Uninstall_Click" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="PluginCount" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="刷新" Click="Refresh_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
