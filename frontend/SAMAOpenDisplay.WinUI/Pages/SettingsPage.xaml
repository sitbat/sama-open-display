<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SAMAOpenDisplay_WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="设置" />
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="应用外观" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="跟随系统，或覆盖为亮色/深色。" />
                    </StackPanel>
                    <ComboBox x:Name="ThemePicker" Grid.Column="1" Width="150" HorizontalAlignment="Right" SelectionChanged="ThemePicker_SelectionChanged">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="亮色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                </Grid>
            </Border>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource SubtitleTextBlockStyle}" Text="启动与后台" />
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="开机自动启动" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="登录 Windows 后自动运行，不需要管理员权限。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" Toggled="StartupToggle_Toggled" />
                </Grid>
            </Border>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="开机启动后隐藏到后台" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="由 Windows 自动启动时不显示主窗口，仅保留系统托盘图标。" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartMinimizedToggle" Grid.Column="1" Toggled="BackgroundToggle_Toggled" />
                </Grid>
            </Border>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="启动软件即开始持续发送画面" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="每次启动软件后，检测到小屏便使用默认主题自动开始持续发送，无需再次确认。" TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartSendingToggle" Grid.Column="1" Toggled="BackgroundToggle_Toggled" />
                </Grid>
            </Border>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="最小化到系统托盘" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击最小化按钮时隐藏任务栏窗口，继续在后台运行。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" Toggled="BackgroundToggle_Toggled" />
                </Grid>
            </Border>
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="关闭时隐藏到系统托盘" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="点击关闭按钮时继续后台运行；可通过托盘菜单彻底退出。" />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloseToTrayToggle" Grid.Column="1" Toggled="BackgroundToggle_Toggled" />
                </Grid>
            </Border>
            <InfoBar x:Name="SettingsStatus" IsOpen="False" IsClosable="True" />
            <Border Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="后端位置" />
                    <TextBlock x:Name="BackendPath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="WinUI 负责界面，已验证的 Python 核心负责协议、渲染和插件安全边界。" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
