<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SAMAOpenDisplay_WinUI.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="28,20,28,28" Spacing="14">
        <Image Width="96" Height="96" HorizontalAlignment="Left" Source="/Assets/Square150x150Logo.scale-200.png" />
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="SAMA Open Display" />
        <TextBlock FontSize="18" Text="用于给 SAMA 屏幕设备显示自定义内容的开源工具" />
        <TextBlock MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap" Text="支持在兼容的 SAMA USB 屏幕设备上显示主题、图片、文字和系统数据。WinUI 3 前端使用经过验证和身份校验的协议核心执行硬件写入。" />
        <TextBlock MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本项目是非官方社区工具，与 SAMA 品牌方不存在隶属、授权或背书关系。" />
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="WinUI 3 · GPL-3.0-or-later" />
    </StackPanel>
</Page>
