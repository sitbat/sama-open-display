<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="SAMA Open Display"
           Manufacturer="SAMA Open Display contributors"
           Version="1.0.0"
           UpgradeCode="A7C8239B-70FD-4496-B8E9-0978A42E4512"
           Scope="perMachine"
           Language="2052">
    <SummaryInformation Description="Open-source tool for displaying custom content on SAMA screen devices" />
    <MajorUpgrade DowngradeErrorMessage="A newer SAMA Open Display version is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SAMA Open Display">
        <Directory Id="PluginFolder" Name="plugins" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="SAMA Open Display" />
    </StandardDirectory>

    <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MainExecutableFile" Source="$(var.PayloadRoot)\SAMAOpenDisplay.exe" KeyPath="yes" />
    </Component>
    <Component Id="WritablePluginFolder" Directory="PluginFolder" Guid="*">
      <CreateFolder>
        <!-- Only plugin packages and state are shared/writable, never the app binaries. -->
        <util:PermissionEx User="[WIX_ACCOUNT_USERS]" GenericWrite="yes"
                           CreateFile="yes" CreateChild="yes" Delete="yes" DeleteChild="yes" />
      </CreateFolder>
      <RegistryValue Root="HKLM" Key="Software\SAMA Open Display"
                     Name="WritablePluginFolder" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="StartMenuFolder" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="StartMenuShortcut" Name="SAMA Open Display"
                Target="[INSTALLFOLDER]SAMAOpenDisplay.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" Advertise="no" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\SAMA Open Display"
                     Name="StartMenuFolder" Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Icon Id="AppIcon" SourceFile="$(var.PayloadRoot)\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sitbat/sama-open-display" />
    <util:QueryWindowsWellKnownSIDs />

    <Feature Id="Complete" Title="SAMA Open Display" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.PayloadRoot)\**">
        <Exclude Files="$(var.PayloadRoot)\SAMAOpenDisplay.exe" />
        <Exclude Files="$(var.PayloadRoot)\plugins\**" />
      </Files>
      <Files Directory="PluginFolder" Include="$(var.PayloadRoot)\plugins\**" />
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="WritablePluginFolder" />
      <ComponentRef Id="StartMenuFolder" />
    </Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerAssets)\License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.InstallerAssets)\Banner.png" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.InstallerAssets)\Dialog.png" />
  </Package>
</Wix>
